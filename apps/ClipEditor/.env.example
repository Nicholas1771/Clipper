POLL_INTERVAL_SECONDS=10
READY_STABILITY_SECONDS=5
WATERMARK_FONT_FILE=
WATERMARK_FONT_NAME=DejaVu Sans
TITLE_PREFIX=Clip

# Source clip only (never the overlays). Contrast: 1.0 = unchanged. Sharpness: 0 = off, ~0.5-1.5 typical.
SOURCE_CONTRAST=1.08
SOURCE_SHARPNESS=0.8

# Watermark. Y: 0.00 = top, 1.00 = bottom. Opacity: 0 = invisible, 1 = opaque. Size: fraction of frame height (0 = none, 1 = full screen).
WATERMARK_TOP_Y=0.50
WATERMARK_BOTTOM_Y=0.50
# Legacy fallback used only when the separate top and bottom values are unset.
WATERMARK_Y=
WATERMARK_OPACITY=0.42
WATERMARK_SIZE=0.02
# Kick overlay vertical position, 0.00 = top edge of frame, 1.00 = bottom edge.
# TOP is used when the AI puts a caption at the bottom; BOTTOM otherwise.
KICK_OVERLAY_TOP_Y=0.26
KICK_OVERLAY_BOTTOM_Y=0.74

# Trim seconds from start and end of final clip (decimal in seconds, e.g. 0.2).
TRIM_START_SECONDS=0.0
TRIM_END_SECONDS=0.0

# Subtle audio pitch scale (1.0 = unchanged, <1.0 = deeper/lower voice). 0.97 is a subtle deep voice shift.
AUDIO_PITCH_SCALE=1.0


