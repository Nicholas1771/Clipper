POLL_INTERVAL_SECONDS=10
READY_STABILITY_SECONDS=5
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
AUTO_REFRESH_TOKEN=true
REFRESH_BUFFER_DAYS=10
MEDIA_BASE_URL=
CLOUDFLARED_PATH=
# Preferred for cloud deploys: use R2 instead of a tunnel/static web server.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_KEY_PREFIX=processing
# If left blank, ClipPublisher will automatically create a temporary Cloudflare Tunnel URL for the queue directory.
CAPTION_PREFIX=
# Required for YouTube AI policy screening; uses the same Gemini settings as ClipAI.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
TIMEOUT_SECONDS=180
AI_PROMPTS_DIR=data/prompts
# Dedicated views-insights version; does not change the existing Instagram publishing API.
INSTAGRAM_INSIGHTS_API_VERSION=v24.0
