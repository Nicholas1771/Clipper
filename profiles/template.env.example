# Use this as a starting point for a shareable profiles\<name>.env.
# Put credentials in profiles\<name>.local.env or provide them in the process environment.
ACCOUNT_NAME=example_account
STREAMER_NAME=Example Streamer
STREAMER_HASHTAG=example

# Queue and state (each profile has its own, so runs never mix)
QUEUE_DIR=data/state/{ACCOUNT_NAME}/queue
STATE_FILE=data/state/{ACCOUNT_NAME}/state.json
SOURCE_HISTORY_FILE=data/state/{ACCOUNT_NAME}/source_history.json
SOURCE_SCHEDULE_FILE=data/state/{ACCOUNT_NAME}/source_schedule.json

# Sourcing
SOURCE_HASHTAG=example
KEYWORD_FILTER=example
SOURCE_MODE=hashtag
SOURCE_PROFILES=
DOWNLOAD_VIDEO_FILES=false
AUTHORIZED_DOWNLOAD_PROFILES=

# Branding image filename under data\assets.
OVERLAY_IMAGE_PATH=overlay.png

# Set Instagram credentials in profiles\<name>.local.env or the process environment.
TOKEN_STATE_FILE=data/state/{ACCOUNT_NAME}/publisher_token_state.json

# This profile's target posts per day
POSTS_PER_DAY=5
