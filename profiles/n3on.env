# N3on profile: everything that differs between streamers/accounts. Selected with --n3on (default).
# ACCOUNT_NAME is the Instagram account: it is the watermark text and names this profile's folders via {ACCOUNT_NAME}
ACCOUNT_NAME=CarootClips
STREAMER_NAME=N3on
STREAMER_HASHTAG=n3on

# Queue and state (each profile has its own, so runs never mix)
QUEUE_DIR=data/state/{ACCOUNT_NAME}/queue
STATE_FILE=data/state/{ACCOUNT_NAME}/state.json
SOURCE_HISTORY_FILE=data/state/{ACCOUNT_NAME}/source_history.json
SOURCE_SCHEDULE_FILE=data/state/{ACCOUNT_NAME}/source_schedule.json

# Sourcing
SOURCE_HASHTAG=n3on
KEYWORD_FILTER=n3on

# Branding (the watermark text is ACCOUNT_NAME)
OVERLAY_IMAGE_PATH=n3on.png

# Instagram account
TOKEN_STATE_FILE=data/state/{ACCOUNT_NAME}/publisher_token_state.json

# Scheduling (this profile's own target posts per day)
POSTS_PER_DAY=5
