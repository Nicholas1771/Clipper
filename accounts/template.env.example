# Copy to accounts\<account>.env (ignored). Run: python run_all_apps.py --<account>
ACCOUNT_NAME=ExampleAccount
# creator:Instagram posts/day:YouTube posts/day; mixed randomly into one account schedule.
CREATORS=example:8:1
# Add another creator: CREATORS=example:8:1,another:4:1
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
YOUTUBE_SELECTION_MODE=instagram_top
# Optional Instagram-only overrides; paths are relative to the repository root.
# Caption is used verbatim, without generated text, prefixes or hashtags.
# INSTAGRAM_CAPTION_FILE=data/captions/example_instagram.txt
# Cover must be JPEG and is hosted unchanged alongside the reel.
# INSTAGRAM_COVER_IMAGE=data/assets/example_instagram_cover.jpg
# Paths default to data/state/{ACCOUNT_NAME}; override only to preserve existing state.
# QUEUE_DIR=data/state/{ACCOUNT_NAME}/queue
# STATE_FILE=data/state/{ACCOUNT_NAME}/state.json
