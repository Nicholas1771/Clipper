# Copy to creators\<creator>.env (ignored), then add creator:ig_daily:yt_daily to an account.
STREAMER_NAME=Example Streamer
STREAMER_HASHTAG=example
OVERLAY_IMAGE_PATH=example.png
SOURCE_MODE=hashtag
SOURCE_HASHTAG=example
KEYWORD_FILTER=example
# Reject unbranded source videos before admitting them to the candidate cache.
REQUIRE_SOURCE_KICK_BRANDING=true
DOWNLOAD_VIDEO_FILES=false
AUTHORIZED_DOWNLOAD_PROFILES=
# Optional creator-specific eligibility overrides:
# LOOKBACK_HOURS=24
# RESULTS_PER_PAGE=50
# MINIMUM_VIEW_COUNT=100000
